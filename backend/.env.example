# Copia questo file in backend/.env e personalizza i valori se necessario.

# Chiave di firma dei token JWT.
# Se lasciata vuota, Saldo ne genera una al primo avvio in backend/data/.secret.
# Per un'app raggiungibile da Internet usa una chiave lunga e casuale e non
# rigenerarla a ogni avvio: cambiarla disconnette tutti i browser.
# Genera con: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
# SALDO_JWT_SECRET=cambia-questa-chiave-con-una-lunga-e-casuale

# Durata della sessione in minuti (default: 43200 = 30 giorni).
# Per un'esposizione su Internet sono consigliati 1440 (1 giorno) o 10080 (7 giorni).
# SALDO_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database SQLAlchemy (default: SQLite in backend/data/saldo.db).
# SALDO_DATABASE_URL=sqlite:///./data/saldo.db

# Origini CORS consentite, in formato JSON (solo per lo sviluppo con Vite).
# Con Caddy sulla stessa origine non serve modificarle. Non usare "*".
# SALDO_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
