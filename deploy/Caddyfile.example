# Esempio di Caddyfile per Saldo.
#
# Configurazione pensata per il homelab:
#   Caddy -> 192.168.1.11:8090 (VM Portainer)
#
# La porta 8090 è la porta host mappata alla 8000 interna del container.
# Se cambi SALDO_PORT nello stack Portainer, aggiorna anche questo valore.
#
# 1. Crea il DNS per saldo.erikartaz.work verso il server Caddy.
# 2. Le porte 80 e 443 devono essere raggiungibili da Internet.
# 3. Inserisci questo blocco nel Caddyfile del tuo container Caddy.
#
# Caddy ottiene e rinnova automaticamente il certificato HTTPS.

https://saldo.erikartaz.work {
	encode zstd gzip

	# Documentazione API e schema OpenAPI: meglio non esporli pubblicamente.
	@docs path /docs* /redoc* /openapi.json
	respond @docs 404

	# Le risposte delle API non devono essere messe in cache.
	@api path /api/*
	header @api Cache-Control "no-store"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# Saldo non carica file: limitiamo il corpo delle richieste.
	request_body {
		max_size 2MB
	}

	# ---------------------------------------------------------------------------
	# AUTENTICAZIONE AGGIUNTIVA OPZIONALE (Basic Auth)
	#
	# ATTENZIONE: NON applicarla a /api/*. Il frontend invia
	#   Authorization: Bearer <JWT>
	# e Caddy basic_auth accetterebbe solo Authorization: Basic, rispondendo 401
	# a tutte le chiamate API.
	#
	# Lasciando il matcher @ui, Basic Auth protegge solo interfaccia e asset;
	# le API restano protette dal login di Saldo (JWT).
	#
	# Genera l'hash con:
	#   caddy hash-password --plaintext 'una-password-lunga-e-casuale'
	#
	# @ui {
	#     not path /api/*
	# }
	# basic_auth @ui {
	#     erika $2a$14$sostituisci_con_l_hash_generato
	# }
	# ---------------------------------------------------------------------------

	reverse_proxy 192.168.1.11:8090 {
		# Caddy inoltra già Authorization e X-Forwarded-For.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}
}
