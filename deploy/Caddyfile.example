# Esempio di Caddyfile per Saldo.
#
# Se Caddy gira in un LXC/container separato dall'host Docker, sostituisci
# 127.0.0.1 con l'IP LAN dell'host Docker (es. 192.168.1.50:8000).
# Se Caddy e Saldo condividono lo stesso host, 127.0.0.1:8000 va bene.
#
# 1. Sostituisci saldo.example.com con il tuo dominio.
# 2. Il DNS del dominio deve puntare all'IP pubblico del server.
# 3. Le porte 80 e 443 devono essere raggiungibili da Internet.
# 4. Avvia Caddy con:
#      caddy run --config C:\caddy\Caddyfile --adapter caddyfile
#
# Caddy ottiene e rinnova automaticamente il certificato HTTPS.

saldo.example.com {
	encode zstd gzip

	# Documentazione API e schema OpenAPI: meglio non esporli pubblicamente.
	@docs path /docs* /redoc* /openapi.json
	respond @docs 404

	# Le risposte delle API non devono essere messe in cache.
	@api path /api/*
	header @api Cache-Control "no-store"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# Saldo non carica file: limitiamo il corpo delle richieste.
	request_body {
		max_size 2MB
	}

	# ---------------------------------------------------------------------------
	# AUTENTICAZIONE AGGIUNTIVA OPZIONALE (Basic Auth)
	#
	# ATTENZIONE: NON applicarla a /api/*. Il frontend invia
	#   Authorization: Bearer <JWT>
	# e Caddy basic_auth accetterebbe solo Authorization: Basic, rispondendo 401
	# a tutte le chiamate API.
	#
	# Lasciando il matcher @ui, Basic Auth protegge solo interfaccia e asset;
	# le API restano protette dal login di Saldo (JWT).
	#
	# Genera l'hash con:
	#   caddy hash-password --plaintext 'una-password-lunga-e-casuale'
	#
	# @ui {
	#     not path /api/*
	# }
	# basic_auth @ui {
	#     erika $2a$14$sostituisci_con_l_hash_generato
	# }
	# ---------------------------------------------------------------------------

	reverse_proxy 127.0.0.1:8000 {
		# Caddy inoltra già Authorization e X-Forwarded-For.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}
}
